# cad_harness real-mode configuration (generated)
HOST=127.0.0.1
PORT=9100

# Python interpreter with build123d / cadgen / OCP installed.
CAD_PYTHON=/Users/wangguoqiang/anaconda3/bin/python3

# Optional: explicit claude-code binary path (auto-discovered when empty).
# CLAUDE_EXECUTABLE=

# Optional: Anthropic API key override. Leave empty to use the claude CLI's own
# auth (ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN from ~/.claude/settings.json).
# ANTHROPIC_API_KEY=

# Optional: model override for the claude subprocess. Leave empty to use the
# claude CLI default (ANTHROPIC_MODEL in ~/.claude/settings.json).
# CLAUDE_MODEL=

# cad-viewer base URL (the harness proxies viewer URLs for the renderer).
CAD_VIEWER_HOST=127.0.0.1
CAD_VIEWER_PORT=3245

# VLM judge MCP server (visual QA): render STEP -> screenshot -> VLM verdict.
# Enables the cad-vlm-judge MCP tools (evaluate_cad_render / evaluate_cad_step)
# for every CAD agent run. Requires `mcp` installed in CAD_PYTHON (done).
CAD_VLM_JUDGE_ENABLED=1

# Optional overrides (services/vlm-judge/server.py ships defaults for all of these).
# VLM_API_KEY=sk-...
# VLM_MODEL=kimi-k2.7-code-highspeed
# VLM_ENDPOINT=http://35.220.164.252:3888/v1/chat/completions

