# blender_plugins 配置

# Blender MCP addon 的 TCP 端点（MCP server 与 viewer 后端都连它）。
BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=9876

# uv 解释器（启动 blender-mcp stdio MCP server）。
BLENDER_UV=/Users/wangguoqiang/.local/bin/uv

# 可选：Blender 可执行文件路径（自动探测 /Applications/Blender.app/Contents/MacOS/Blender）。
# BLENDER_BIN=

# 可选：渲染预览图路径（前端实时预览用，默认 ~/.coderix/blender/preview.png）。
# BLENDER_PREVIEW_PATH=
